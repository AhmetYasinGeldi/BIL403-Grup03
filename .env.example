# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env depoya eklenmez.

# Oturum çerezlerini imzalamak için uzun, rastgele bir değer
SECRET_KEY=buraya-uzun-rastgele-bir-deger-yazin

# Görevli olarak kayıt olurken istenecek davet kodu
STAFF_INVITE_CODE=buraya-gorevli-davet-kodu-yazin

# Veritabanı adresi (boş bırakılırsa instance/kampusemanet.db kullanılır)
DATABASE_URL=

# İşlem yapılmadığında oturumun kapanacağı süre (dakika)
SESSION_TIMEOUT_MINUTES=30

# Sahiplenilmeyen eşyaların saklama süresi (gün)
RETENTION_DAYS=365
